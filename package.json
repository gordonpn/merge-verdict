{
  "name": "merge-verdict",
  "version": "0.1.0",
  "description": "Automated, evidence-based pull request verification and approval system",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
