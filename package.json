{
  "name": "merge-verdict",
  "version": "0.1.0",
  "description": "Automated, evidence-based pull request verification and approval system",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "test:build": "pnpm run build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "4.1.12",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
